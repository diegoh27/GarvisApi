# ===============================
# SERVER
# ===============================
PORT=3001

# ===============================
# DATABASE (MySQL)
# ===============================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=garvis
DB_PORT=3306


RESET_DATABASE_ON_STARTUP=false
ALLOW_DB_RESET_IN_PRODUCTION=false

# ===============================
# AUTH / JWT (si luego usas)
# ===============================
JWT_SECRET=*****

# ===============================
# EMAIL (Resend)
# ===============================
RESEND_API_KEY=
RESEND_FROM=no-reply@garbis.online

# Base URLs para enlaces de verificacion y reset
APP_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Producción (ver api/.env.production.example):
# APP_BASE_URL=https://api.garbis.online
# WEB_BASE_URL=https://garbis.online
# FRONTEND_URL=https://garbis.online
# BASE_URL_SERVER=https://api.garbis.online
# URL_BASE_FRONT=https://garbis.online

# ======================= CLOUDINARY =========================
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# == API_environment_variable
CLOUDINARY_URL=

# ===============================
# CORS
# ===============================
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL=https://garbis.online

# ===============================
# ORTHANC PACS
# ===============================
# URL interna de Orthanc (Express → Orthanc, nunca expuesta al exterior)
ORTHANC_URL=http://localhost:8042
# URL del OHIF Viewer accesible desde el navegador del usuario
# Local:      http://localhost:3000
# Producción: https://ohif.garbis.online
OHIF_BASE_URL=http://localhost:3000
# Credenciales de Orthanc (dejar vacío en local — auth deshabilitada)
# En producción usar valores seguros; también se usan en docker-compose.prod.yml
ORTHANC_ADMIN_USER=
ORTHANC_ADMIN_PASS=

# ===============================
# NOTES
# ===============================
# 1) Copia este archivo como ".env"
# 2) Ajusta los valores según tu entorno
# 3) Nunca subas el .env real a GitHub
