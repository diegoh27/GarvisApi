# Copiar en el VPS:  cp .env.production.example .env
# Sin espacios antes del nombre de variable (evita que dotenv no las lea).

PORT=3001
NODE_ENV=production

# MySQL (mismo servidor)
DB_HOST=localhost
DB_USER=garbis
DB_PASSWORD=TU_PASSWORD
DB_NAME=garvis
DB_PORT=3306

RESET_DATABASE_ON_STARTUP=false
ALLOW_DB_RESET_IN_PRODUCTION=false

# URLs públicas
BASE_URL_SERVER=https://api.garbis.online
URL_BASE_FRONT=https://garbis.online
UPLOADS_BASE_URL=https://api.garbis.online
UPLOADS_DIR=/var/www/garvis/uploads

APP_BASE_URL=https://api.garbis.online
WEB_BASE_URL=https://garbis.online
FRONTEND_URL=https://garbis.online

# JWT (usar valor seguro en producción)
JWT_SECRET=CAMBIAR_EN_PRODUCCION
PALABRA_SECRETA=CAMBIAR_EN_PRODUCCION

# Email
RESEND_API_KEY=
RESEND_FROM=no-reply@garbis.online

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Orthanc (interno en el VPS)
ORTHANC_URL=http://localhost:8042
OHIF_BASE_URL=https://ohif.garbis.online
ORTHANC_ADMIN_USER=
ORTHANC_ADMIN_PASS=
