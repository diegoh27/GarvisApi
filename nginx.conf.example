# Configuración nginx para SPA en raíz del dominio
# Ubicar en: /etc/nginx/sites-available/garbis.online
# Luego: sudo ln -s /etc/nginx/sites-available/garbis.online /etc/nginx/sites-enabled/

server {
    listen 80;
    listen [::]:80;
    server_name garbis.online www.garbis.online;

    # Redirigir HTTP a HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name garbis.online www.garbis.online;

    # Certificados SSL (usar Certbot con Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/garbis.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/garbis.online/privkey.pem;

    # Frontend React en subcarpeta
    location /GarvisApi/web/dist/ {
        alias /var/www/garbis.online/GarvisApi/web/dist/;
        index index.html;
        
        # SPA routing - intenta servir el archivo, si no existe va a index.html
        try_files $uri $uri/ /GarvisApi/web/dist/index.html;
        
        # Caché para assets
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # Ruta raíz (opcional, puede redirigir o servir otra cosa)
    location / {
        return 301 /GarvisApi/web/dist/;
    }
}

# Configuración para api.garbis.online
server {
    listen 80;
    listen [::]:80;
    server_name api.garbis.online;

    # Redirigir HTTP a HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.garbis.online;

    # Certificados SSL
    ssl_certificate /etc/letsencrypt/live/api.garbis.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.garbis.online/privkey.pem;

    # Proxy al backend Node.js (ajusta el puerto según tu app)
    location / {
        proxy_pass http://localhost:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
